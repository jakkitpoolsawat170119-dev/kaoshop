    {
      "parameters": {
        "jsCode": "// แยก UGC Script จาก GPT และเตรียม Veo 3 request\nconst gptRaw = $('GPT เขียน UGC Script1').first().json;\nconst rawText = gptRaw.output?.[0]?.content?.[0]?.text || gptRaw.message?.content || '';\nconst cleaned = rawText.replace(/^```json\\n?/i,'').replace(/^```\\n?/i,'').replace(/\\n?```$/i,'').trim();\n\nlet script = {};\ntry {\n  script = JSON.parse(cleaned);\n} catch(e) {\n  console.log('Parse error, using fallback:', e.message);\n  const sheet = $('เตรียมข้อมูล').first().json;\n  script = {\n    thaiScript: `ลองแล้วบอกเลย ${(sheet['product_name']||'').replace(/^=+/,'').trim()} คุ้มมากเลยนะ จุดเด่นชัดมาก ดูรีวิวเต็มที่ KaoShop ได้เลย`,\n    videoDirection: `Young Thai woman presenter reviewing a product, holding it up to camera, smiling naturally, bright clean background`\n  };\n}\n\nconst sheet = $('เตรียมข้อมูล').first().json;\nconst productName = (sheet['product_name'] || '').replace(/^=+/, '').trim();\nconst img1 = $('แปลงรูป Cloudinary1').first().json?.secure_url || '';\n\n// สร้าง Veo 3 prompt: รวม video direction + Thai dialogue\nconst videoPrompt = [\n  script.videoDirection,\n  `She looks at the camera and speaks naturally in Thai: \"${script.thaiScript}\"`,\n  'Generate with native Thai audio and perfect lip sync.',\n  'Bright professional lighting, 16:9 aspect ratio, UGC style, cinematic quality.'\n].join(' ');\n\nconsole.log(`UGC Script สำหรับ: ${productName}`);\nconsole.log(`Thai Script: ${script.thaiScript}`);\nconsole.log(`Image URL: ${img1}`);\n\nreturn [{\n  json: {\n    thaiScript: script.thaiScript,\n    videoPrompt,\n    imageUrl: img1,\n    productName\n  }\n}];"
      },
