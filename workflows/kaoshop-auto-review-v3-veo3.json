    {
      "parameters": {
        "jsCode": "// ดึง output จาก Editor Agent\nconst editorRaw = $('Editor Agent1').first().json;\nconst rawText = editorRaw.output?.[0]?.content?.[0]?.text || editorRaw.message?.content || '';\nconst cleaned = rawText.replace(/^```json\\n?/i,'').replace(/^```\\n?/i,'').replace(/\\n?```$/i,'').trim();\n\nlet editorResult = {};\ntry { editorResult = JSON.parse(cleaned); } catch(e) { editorResult = { content: cleaned }; }\n\nconst htmlContent = editorResult.content || cleaned;\nconst rating = editorResult.rating || null;\nconst scoreBreakdown = editorResult.scoreBreakdown || null;\n\n// ดึงข้อมูลจาก Sheet\nconst sheet = $('เตรียมข้อมูล').first().json;\nconst productName = (sheet['product_name'] || '').replace(/^=+/, '').trim();\nconst price = String(sheet['price'] || '').replace(/^=+/, '').trim();\nconst affiliateUrl = sheet['affiliate_url'] || '';\nconst categoryName = sheet['category'] || 'ทั่วไป';\n\n// ดึง Video URL จาก Veo 3 (ผ่าน kie.ai)\nconst veo3Resp = $('เช็คสถานะ Veo 31').first().json;\nlet videoUrl = null;\ntry {\n  // อ่านจาก Cloudinary (ถาวร)\n  const cloudinaryResp = $('Upload Video Cloudinary1').first().json;\n  videoUrl = cloudinaryResp?.secure_url || null;\n  // fallback: kie.ai temp URL\n  if (!videoUrl) videoUrl = veo3Resp?.data?.response?.resultUrls?.[0] || null;\n} catch(e) { console.log('Video URL error:', e.message); }\n\nif (videoUrl) console.log(`Veo 3 Video URL: ${videoUrl}`);\nelse console.log('ไม่พบ Video URL:', JSON.stringify(veo3Resp?.data));\n\n// ดึงรูปจาก Cloudinary\nconst img1 = $('แปลงรูป Cloudinary1').first().json?.secure_url || '';\nconst img2 = $('แปลงรูป Cloudinary4').first().json?.secure_url || '';\nconst img3 = $('แปลงรูป Cloudinary5').first().json?.secure_url || '';\nconst images = [img1, img2, img3].filter(Boolean);\n\nconst baseSlug = productName.toLowerCase().replace(/[^a-z0-9\\s-]/g,'').replace(/\\s+/g,'-').replace(/-+/g,'-').replace(/^-|-$/g,'').substring(0,60);\nconst slug = (baseSlug || 'article') + '-' + Date.now();\n\nconst title = editorResult.title || `รีวิว ${productName}${price ? ' ราคา ' + price + ' บาท' : ''}`;\nconst excerpt = `รีวิวครบ ${productName} พร้อมข้อดี-ข้อเสีย คะแนน ${rating ? rating.toFixed(1) : '?'}/5 และความคุ้มค่าราคา`;\n\nreturn [{\n  json: {\n    title, slug, excerpt,\n    content: htmlContent,\n    featuredImage: images[0] || null,\n    images,\n    rating, scoreBreakdown,\n    pros: [],\n    cons: [],\n    affiliateUrl,\n    price: String(price),\n    productName,\n    categoryName,\n    categorySlug: categoryName.toLowerCase().replace(/\\s+/g,'-'),\n    videoUrl: videoUrl || null,\n    published: true\n  }\n}];"
      },
