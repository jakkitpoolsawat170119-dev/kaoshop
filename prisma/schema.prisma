generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// หมวดหม��่สินค้า
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  image     String?
  createdAt DateTime  @default(now())
  articles  Article[]
}

// บทความรีวิว
model Article {
  id             Int       @id @default(autoincrement())
  title          String
  slug           String    @unique
  excerpt        String    // สรุปสั้นๆ
  content        String    // เนื้อหาบทความ (HTML)
  featuredImage  String?   // รูปปก
  images         String?   // JSON array ของรูปสินค้าทั้งหมด (Cloudinary URLs)
  rating         Float     @default(0) // คะแนน 0-5
  pros           String?   // ข้อดี (JSON array)
  cons           String?   // ข้อเสีย (JSON array)
  affiliateUrl   String?   // ลิงก์ Shopee Affiliate
  price          String?   // ราคา
  productName    String?   // ชื่อสินค้า
  scoreBreakdown String?   // JSON: {value, quality, performance, design, ease} คะแนน 0-10
  useCases       String?   // JSON array: ["ทำงาน", "เดินทาง", ...]
  published      Boolean   @default(false)
  views          Int       @default(0)
  clicks         Int       @default(0) // จำนวนคลิก affiliate link
  videoUrl       String?   // URL ของวิดีโอรีวิว (YouTube / TikTok)
  myjakkitUrl    String?   // URL บทสรุปหนังสือที่ myjakkit.com (เฉพาะหมวดหนังสือ)
  author         String?   // ชื่อผู้เขียน (เฉพาะหมวดหนังสือ)
  categoryId     Int
  category       Category  @relation(fields: [categoryId], references: [id])
  tiktokScripts  TikTokScript[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// คอนเทนต์ TikTok ที่สร้างจาก Content Studio (บทพูด/แคปชั่น/แฮชแท็ก) สำหรับโพสต์เอง
model TikTokScript {
  id          Int      @id @default(autoincrement())
  articleId   Int?     // อ้างอิง Article ถ้า gen จากบทความ (optional — กรอกสินค้าเองก็ได้)
  article     Article? @relation(fields: [articleId], references: [id])
  productName String   // ชื่อสินค้าที่ใช้ตอน gen
  script      String   // บทพูด/สคริปต์วิดีโอ
  caption     String   // แคปชั่น
  hashtags    String   // JSON array ของแฮชแท็ก (ตามแพทเทิร์น pros/cons)
  model       String   @default("gpt-4o-mini")
  status      String   @default("draft") // draft | copied | posted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// API Key สำหรับ n8n
model ApiKey {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Coupon {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  description String
  discount    String
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}
